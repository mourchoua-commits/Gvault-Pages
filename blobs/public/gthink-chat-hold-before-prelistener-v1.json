{
  "schema": "GTHINK_CHAT_HOLD_BEFORE_PRELISTENER_BLOB_V1",
  "blobId": "blob:public:gthink:chat-hold-before-prelistener:v1",
  "version": "1.0.0",
  "status": "ACTIVE",
  "kind": "CHAT_HOLD_GATE_BLOB",
  "surface": "Gvault-Pages",
  "placement": "PUBLIC_CHAT_BEFORE_PRELISTENER",
  "purpose": "hold a chat request until the GThink listener is ready so the existing live-blob route does not return before gateway.request exists",
  "timing": {
    "maxHoldMs": 20000,
    "pollMs": 100,
    "probeEveryMs": 500
  },
  "routing": {
    "input": "POST /api/vault/chat",
    "holdWhen": "GVAULT_AGENT_LIVE_BLOB.status().responderReady !== true",
    "releaseWhen": "responderReady === true",
    "next": "existing GVAULT_AGENT_LIVE_BLOB chat route",
    "then": "self-invocation-prelistener -> gateway.request -> GThinkPrelistener"
  },
  "guards": {
    "callDownstreamFetchOnce": true,
    "noDuplicateUserUtterance": true,
    "noMessageRewrite": true,
    "noRecursiveFetch": true,
    "failOpenAfterTimeout": true
  },
  "receipt": {
    "hold": "gthink.chat.hold",
    "release": "gthink.chat.hold.release",
    "timeout": "gthink.chat.hold.timeout"
  }
}
