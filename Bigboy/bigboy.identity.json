{
  "schema": "GVAULT_BIG_BOY_IDENTITY_V1",
  "version": "7.1.0",
  "name": "GVAULT BIG BOY",
  "role": "declared-health-observer",
  "purpose": "health-check-change-observation-and-declared-source-discovery",
  "mode": "read-only",
  "collects": [
    "feed metadata",
    "public item identifiers",
    "timestamps",
    "HTTP status",
    "ETag/Last-Modified",
    "content fingerprints",
    "declared public health/status fields",
    "same-origin feed links declared by the page",
    "same-origin Sitemap references declared by robots.txt"
  ],
  "discovery": {
    "sameOriginOnly": true,
    "standardPaths": [
      "/robots.txt",
      "/sitemap.xml",
      "/.well-known/security.txt",
      "/health",
      "/healthz",
      "/status",
      "/api/health"
    ],
    "portScanning": false,
    "bruteForcePaths": false,
    "deepCrawl": false
  },
  "doesNotCollect": [
    "passwords",
    "form values",
    "cookies",
    "authorization headers",
    "private messages",
    "private group content",
    "raw credential material"
  ],
  "contact": "GVAULT / BIG BOY",
  "optOut": "Remove the source from Little Boy scout registry or deny the declared User-Agent."
}
