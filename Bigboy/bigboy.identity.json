{
  "schema": "GVAULT_BIG_BOY_IDENTITY_V1",
  "version": "7.2.0",
  "name": "GVAULT BIG BOY",
  "role": "declared-health-observer",
  "purpose": "health-check-change-observation-and-authorized-scope-discovery",
  "mode": "read-only",
  "collects": [
    "feed metadata",
    "public item identifiers",
    "timestamps",
    "HTTP status",
    "ETag/Last-Modified",
    "content fingerprints",
    "declared public health/status fields",
    "feed links declared by pages inside the authorized scope",
    "Sitemap references declared by robots.txt",
    "standard readiness/liveness/status surfaces",
    "bounded links whose host remains inside the authorized scope"
  ],
  "discovery": {
    "scopeModel": "AUTHORIZED_SCOPE",
    "sameOriginOnly": false,
    "subdomainsConfigurable": true,
    "additionalAllowedHostsConfigurable": true,
    "defaultMaxDepth": 2,
    "defaultMaxRedirects": 3,
    "defaultRequestBudgetPerSeed": 80,
    "standardPaths": [
      "/robots.txt",
      "/sitemap.xml",
      "/sitemap_index.xml",
      "/feed",
      "/feed.xml",
      "/rss",
      "/rss.xml",
      "/atom.xml",
      "/index.xml",
      "/.well-known/security.txt",
      "/.well-known/assetlinks.json",
      "/health",
      "/healthz",
      "/ready",
      "/readyz",
      "/live",
      "/livez",
      "/status",
      "/api/health",
      "/api/status",
      "/version"
    ],
    "portScanning": false,
    "bruteForcePaths": false,
    "unboundedCrawl": false,
    "robotsRespectedByDefault": true
  },
  "doesNotCollect": [
    "passwords",
    "form values",
    "cookies",
    "authorization headers",
    "private messages",
    "private group content",
    "raw credential material"
  ],
  "contact": "GVAULT / BIG BOY",
  "optOut": "Remove the source from Little Boy scout registry, narrow its authorized scope, or deny the declared User-Agent."
}
