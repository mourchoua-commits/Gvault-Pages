{
  "schema": "GVAULT_BIG_BOY_PUBLIC_V1",
  "version": "7.2.0",
  "role": "declared-health-observer-identity-surface",
  "identity": "bigboy.identity.json",
  "runtimePublic": false,
  "secretsPublic": false,
  "littleBoyDataPublic": false,
  "capabilities": [
    "declared read-only health observation",
    "RSS/Atom/JSON Feed observation",
    "authorized-scope feed auto-discovery",
    "robots.txt and Sitemap discovery",
    "standard public health/readiness/status discovery",
    "authorized subdomain discovery",
    "bounded redirect following",
    "bounded depth discovery crawl"
  ],
  "discoveryPolicy": {
    "scopeModel": "AUTHORIZED_SCOPE",
    "sameOriginOnly": false,
    "subdomainsConfigurable": true,
    "additionalAllowedHostsConfigurable": true,
    "maxRedirectsDefault": 3,
    "maxDepthDefault": 2,
    "maxPagesPerSeedDefault": 30,
    "requestBudgetPerSeedDefault": 80,
    "portScanning": false,
    "bruteForcePaths": false,
    "unboundedCrawl": false,
    "privateNetworksByDefault": false,
    "robotsRespectedByDefault": true
  },
  "notes": [
    "Public surface contains identity and capability metadata only.",
    "Scout runtime and Little Boy collector remain outside this public directory.",
    "BIG BOY declares read-only health-check intent in its User-Agent and X-BigBoy headers.",
    "Extended scope is configurable but remains bounded to explicitly authorized hosts."
  ]
}
