{
  "schema": "GVAULT_CONTROL_TOWER_CONTRACT_V2",
  "version": "0.2.2",
  "status": "CANDIDATE_E2E_PENDING",
  "publicSurface": "Gvault-Pages/essai/control-tower/v2.html",
  "privateRepository": "mourchoua-commits/Gvault",
  "primaryEventPlane": "vigie-state",
  "trackRegistry": "vigie-state:modules/vigie/control_tower_tracks.json",
  "entryGate": {
    "requiresGvaultSasSession": true,
    "principalCredential": "existing GVAULT SAS password",
    "passwordTransferToControlTower": false,
    "sessionAssertion": "sessionStorage:gvault.controlTower.entry.v1",
    "assertionMaxAgeHours": 8,
    "directNavigationWithoutAssertion": "RETURN_TO_GVAULT",
    "securityBoundary": "CLIENT_SIDE_NAVIGATION_GATE_NOT_SERVER_AUTHORIZATION"
  },
  "unifiedSas": {
    "recurringUserGate": "GVAULT_SAS_ONLY",
    "githubPasswordReuse": false,
    "reason": "GitHub API requires a token, not the GVAULT password",
    "firstDeviceSetup": "paste fine-grained GitHub token once after GVAULT SAS",
    "credentialAtRest": "AES-GCM encrypted IndexedDB capsule",
    "wrappingKey": "non-extractable WebCrypto AES-GCM CryptoKey stored in IndexedDB",
    "automaticRestore": "only after a valid GVAULT session assertion",
    "plaintextTokenPersistence": false,
    "forgetDeviceControl": true,
    "newDeviceRequiresSetup": true,
    "fallbackIfIndexedDbOrCryptoKeyStorageUnavailable": "manual token entry for that session; never persist plaintext"
  },
  "privateDataCredential": {
    "kind": "GitHub fine-grained personal access token",
    "purpose": "read private Gvault event planes and write Control Tower track registry",
    "recommendedRepositoryScope": "mourchoua-commits/Gvault",
    "recommendedContentsPermission": "read-and-write",
    "mustNeverBeBakedIntoPublicSource": true
  },
  "swarmContamination": {
    "idPrefix": "SWARM-",
    "toggleByReclick": true,
    "preserveHistoryWhenStopped": true,
    "propagation": "PROVEN_LINEAGE_ONLY",
    "transitiveNewRamifications": true,
    "ambiguousLineage": "BRANCH_SOURCE_REQUIRED_NO_AUTO_MARK",
    "gitAncestryAlone": "INSUFFICIENT",
    "workProtocol": "WORK_SPECIAL",
    "workBindingPersistedInTrackRegistry": true
  },
  "invariants": [
    "no_private_data_baked_into_public_page",
    "no_gvault_password_transfer_to_control_tower",
    "no_plaintext_token_persistence",
    "github_token_setup_is_one_time_per_device_when_supported",
    "normal_recurring_entry_requires_only_the_existing_gvault_sas",
    "control_tower_button_hidden_until_gvault_runtime_ready",
    "direct_navigation_redirected_without_same_tab_session_assertion",
    "client_side_gate_is_not_claimed_as_server_side_security",
    "sources_remain_authoritative",
    "swarm_marks_are_reversible_but_history_is_preserved",
    "unrelated_git_descendants_do_not_inherit_work_special",
    "ambiguous_lineage_fails_closed",
    "no_false_pass"
  ]
}
