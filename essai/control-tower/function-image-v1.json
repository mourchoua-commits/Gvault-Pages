  "role": "VERSIONED_FUNCTION_MAP_USED_BY_CONTROL_TOWER",
  "publicSurface": "essai/control-tower/v2.html",
  "functions": [
    {"id":"SOURCE_ROUTING","runtime":"source-router-v1.mjs","modes":["PRIVATE_MASTER_PROJECTION","LOCAL_VFS","REMOTE_COMPATIBLE_SOURCE"]},
    {"id":"PUBLIC_ACTIVITY","runtime":"public-live-v1.mjs","authority":"NON_AUTHORITATIVE_PUBLIC_OBSERVATION"},
    {"id":"PULSE","runtime":"pulse-sampler-v1.mjs","core":"pulse-core-v1.mjs","truthRule":"PREDICTION_NEVER_REPLACES_OBSERVATION"},
    {"id":"COMMIT_WATCH","runtime":"commit-watcher-v1.mjs","role":"HEAD_CHANGE_DETECTION"},
    {"id":"ENCRYPTED_VFS","runtime":"encrypted-vfs-v2.mjs","role":"CIPHERTEXT_SNAPSHOT_MEMORY"},
    {"id":"COMMIT_IMAGE_VFS","runtime":"commit-capsule-vfs-v1.mjs","role":"SHA_KEYED_TRANSLATION_MEMORY"},
    {"id":"SHA_CHAIN","runtime":"content-addressed-feed-v2.mjs","role":"CONTENT_ADDRESSED_CONTINUITY"},
    {"id":"SAS_HANDOFF","runtime":"../private-tool-session-v1.mjs","role":"LIVE_PRINCIPAL_SAS_ONLY"},
