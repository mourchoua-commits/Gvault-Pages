  "commitImage": {
    "schema": "GVAULT_CONTROL_TOWER_COMMIT_CAPSULE_V1",
    "lookup": "commit-capsules/<previousCommitSha>.json",
    "rule": "commit N+1 carries a deterministic capsule summarizing commit N",
    "pulseKey": "CTP1:<commitSha>:<pulseDigest16>",
    "translationVfs": "IndexedDB gvault-control-tower-vfs-translation-v1",
    "translationLookup": ["commitSha", "pulseKey"],
    "reconstruction": "known commit SHA -> capsule -> verified pulseKey -> local VFS translation -> Control Tower image",
    "oneCommitLag": true
  },
  "invariants": [
    "a commit cannot self-address its own SHA before creation",
    "therefore the following commit carries the previous commit capsule",
    "pulse is evidence metadata, not authority",
    "translation is cached locally and can be replayed without re-reading the full activity stream",
    "private data must not be emitted into public capsules",
    "function image version is explicit and independently versioned"
  ]
