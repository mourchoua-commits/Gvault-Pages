    "sourceAndTargetLanguagesRemainSeparate": true
  },
  "permissions": {
    "network": "NONE",
    "git": "NONE",
    "privateRepository": "NONE",
    "remoteDelivery": false,
    "remoteAcknowledgment": false,
    "methodRouterDecision": false
  },
  "existingCBorder": "STRICT_SIX_FIELDS_NO_PAYLOAD_UNCHANGED",
