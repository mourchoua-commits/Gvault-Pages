  "guards": [
    "NO_AUTO_PRIVATE_EXPORT",
    "NO_RAW_PRIVATE_TOKENS",
    "NO_FAKE_TRANSLATION",
    "NO_CROSS_CORE_SEND",
    "NO_CANONICAL_AUTHORITY"
  ]
}
