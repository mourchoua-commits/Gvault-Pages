{
  "schema": "GVAULT_FULL_SAVE_DIRECT_BANANA_STUDY_MANIFEST_V1",
  "version": "1.1.0",
  "branch": "study/full-save-direct-banana",
  "target": "Gvault-Pages public banana surface -> existing GVAULT local Agent",
  "methodology": {
    "name": "FULL_SAVE_ASSEMBLE_THEN_TEST",
    "description": "Capture the relevant public state first, execute the complete local-routed turn as one parent blob, materialize every action as a child blob, verify the banana mirror, then capture the final state.",
    "everyActionIsBlob": true,
    "silent": true,
    "muted": false
  },
  "agent": {
    "lineage": "GU1.3.2 GTHINK ROUTED AGENT",
    "provider": "GVAULT_AGENT_LOCAL_GTHINK",
    "remoteProvider": false,
    "openAI": false,
    "methodAuthority": "GVAULT_METHOD_ROUTER",
    "integrationPoint": "sendAgentMessage -> agentGThinkRouteRequest -> agentAnswer -> recordAgentTrace",
    "invocationScope": "EVERY_NEW_USER_MESSAGE"
  },
  "browserBridge": {
    "script": "scripts/gvault-agent-live-blob.js",
    "schema": "GVAULT_AGENT_LIVE_BLOB_CLIENT_V3_LOCAL_GTHINK",
    "compatibilitySurface": "/api/vault/chat",
    "networkRequired": false,
    "behavior": "POST /api/vault/chat is intercepted locally and translated into runtime.sendAgentMessage(message).",
    "runtimeResolver": "#gvaultRuntime.contentWindow",
    "serviceWorkerVersion": "gvault-shell-v1-20260901-agent-local-gthink-v3"
  },
  "turnActions": [
    "banana.turn.begin",
    "input.capture",
    "runtime.resolve",
    "gthink.route.entry",
    "sendAgentMessage",
    "gthink.route.exit",
    "banana.verify",
    "banana.turn.pass"
  ],
  "tests": {
    "fullSavePipeline": "PASS_27_27",
    "localGThinkBananaAdapter": "PASS_25_25",
    "bananaMismatchFailurePath": "PASS",
    "remoteProviderRequired": false,
    "browserScriptSyntax": "PENDING_RECHECK",
    "realPostSasRuntimeBinding": "PENDING_STUDY_BRANCH_BROWSER_CHECK"
  },
  "truthBoundary": {
    "fullSaveMethodologyCanWrapTheLocalAgentTurn": true,
    "allStudyActionsCanBeRepresentedAsBlobs": true,
    "bananaCanBeVerifiedBeforeTurnPass": true,
    "remoteApiOrCloudWorkerNeeded": false,
    "mainBranchChangedByThisLocalStudy": false
  },
  "promotion": "STUDY_ONLY_UNTIL_BROWSER_BINDING_PASS"
}
